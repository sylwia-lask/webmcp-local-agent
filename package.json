{
  "name": "webmcp-local-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local Chrome extension: a simple AI agent that uses WebMCP tools on the current page plus a local Ollama model.",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
